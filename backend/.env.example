# Local development: point at your local Postgres
# Production (Render): paste your Neon connection string here in the Render dashboard,
# never commit real values to this file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pnw_pathway

# Any long random string. Render can auto-generate this (see render.yaml).
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Optional. Leave unset to run the AI assistant in citation-only fallback mode
# (retrieves and quotes the approved documents, no external API calls, no cost).
# Set this to enable natural-language answers via the Anthropic API.
ANTHROPIC_API_KEY=

# Set to "true" when DATABASE_URL points at a managed host that requires SSL
# (Neon, Render Postgres). Leave unset/false for local Postgres.
PGSSL=false

# Optional. Leave unset to log reminder emails instead of sending them
# (zero cost, zero setup). Set this to a Resend API key to send real email.
RESEND_API_KEY=

# Optional. Only used when RESEND_API_KEY is set; the "From" address/name
# reminder emails are sent as. Must be a verified sender in Resend.
REMINDER_FROM_EMAIL=PNW Pathway <reminders@pnwpathway.example>
